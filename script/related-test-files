#!/usr/bin/env bash

set -euo pipefail

TAB=$(printf "\t")

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
CURRENT_DIR=$(pwd)
if [ "$SCRIPT_DIR" != "$CURRENT_DIR/script" ]; then
    echo "error: this script should be called from project root"
    exit 1
fi

# prepare target files
TARGETS_FILE=$(mktemp)
trap 'rm -f "$TARGETS_FILE"' EXIT
for arg in "$@"; do
    arg_abs=$(realpath "$arg")
    src_prefix="${CURRENT_DIR}/src/"
    if [[ "$arg_abs" == "$src_prefix"* ]]; then
        # cpp source file cannot be a direct dependency, convert to header file
        relative_path="${arg_abs#$src_prefix}"
        if [[ "$relative_path" == "gate/update_ops"* ]]; then
            echo "${CURRENT_DIR}/include/scaluq/gate/gate.hpp" >> "$TARGETS_FILE"
        else
            echo "${CURRENT_DIR}/include/scaluq/${relative_path/.cpp/.hpp}" >> "$TARGETS_FILE"
        fi
    else
        printf '%s\n' "$arg_abs" >> "$TARGETS_FILE"
    fi
done

# configure the Ninja build
variables="CMAKE_C_COMPILER \
  CMAKE_CROSSCOMPILING_EMULATOR \
  CMAKE_CXX_COMPILER \
  CMAKE_BUILD_TYPE \
  CMAKE_INSTALL_PREFIX \
  SCALUQ_USE_OMP \
  SCALUQ_USE_CUDA \
  SCALUQ_USE_HIP \
  SCALUQ_USE_SYCL \
  SCALUQ_CPU_NATIVE \
  SCALUQ_CPU_ARCH \
  SCALUQ_CUDA_ARCH \
  SCALUQ_HIP_ARCH \
  SCALUQ_SYCL_ARCH \
  SCALUQ_USE_TEST \
  SCALUQ_USE_EXE \
  SCALUQ_FLOAT16 \
  SCALUQ_FLOAT32 \
  SCALUQ_FLOAT64 \
  SCALUQ_BFLOAT16 \
  SCALUQ_TEST_SOURCES \
  SCALUQ_USE_MOLD"

CMAKE_OPS=""
for var in $variables; do
  eval value=\${$var:-}
  if [ -n "$value" ]; then
    CMAKE_OPS="${CMAKE_OPS} -D $var=$value"
  fi
done

mkdir -p ./build
cmake -B build -G Ninja ${CMAKE_OPS} > /dev/null

# Read Ninja's actual commands to retain compiler launchers such as Kokkos's CUDA wrapper.
ninja -C build -t compdb -x | \
jq -r --arg prefix "$CURRENT_DIR/tests/" '.[] | select(.file | startswith($prefix)) | [.directory, .file, .command] | @tsv' | \
while IFS="$TAB" read -r dir file command; do
    command_enumerate_includes=$(printf '%s\n' "$command" | sed -E 's/ -MD / /g; s/ -(MT|MF|o) [^ ]+//g; s/ -c / -M /')
    deps_abs=$(cd "$dir" && eval "$command_enumerate_includes" | \
               sed 's/.*: //' | sed 's/\\//g' | tr -s '[:space:]' '\n' | \
               grep -E "${CURRENT_DIR}/include/scaluq/|${CURRENT_DIR}/tests/" | \
               xargs -I {} realpath "{}")

    if echo "$deps_abs" | grep -Fxf "$TARGETS_FILE" > /dev/null; then
        echo "$file"
    fi
done
