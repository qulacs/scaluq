@@ -785,6 +785,32 @@ struct Random_UniqueIndex<Kokkos::Device<Kokkos::SYCL, MemorySpace>> {
       View<int**, Kokkos::Device<Kokkos::SYCL, MemorySpace>>;
   KOKKOS_FUNCTION
   static uint64_t get_state_idx(const locks_view_type& locks_) {
+#if defined(__ACPP__)
+    // F2 experiment: AdaptiveCpp has no free-function nd_item query, so take
+    // the work-item ids from the SSCP builtins. Starting from the global
+    // linear id (as the other backends do) keeps the state assignment, and
+    // therefore seeded results, deterministic.
+    const uint64_t n_locks = locks_.extent(0);
+    uint64_t i = 0, i_offset = 0, block_size = 1;
+    KOKKOS_IF_ON_DEVICE((
+        const uint64_t bx = __acpp_sscp_get_local_size_x();
+        const uint64_t by = __acpp_sscp_get_local_size_y();
+        const uint64_t bz = __acpp_sscp_get_local_size_z();
+        block_size        = bx * by * bz;
+        i_offset = (__acpp_sscp_get_local_id_z() * by +
+                    __acpp_sscp_get_local_id_y()) * bx +
+                   __acpp_sscp_get_local_id_x();
+        const uint64_t group =
+            (__acpp_sscp_get_group_id_z() * __acpp_sscp_get_num_groups_y() +
+             __acpp_sscp_get_group_id_y()) * __acpp_sscp_get_num_groups_x() +
+            __acpp_sscp_get_group_id_x();
+        i = (group * block_size + i_offset) % n_locks;))
+    while (Kokkos::atomic_compare_exchange(&locks_(i, 0), 0, 1)) {
+      i += block_size;
+      if (i >= n_locks) i = i_offset % n_locks;
+    }
+    return i;
+#else
 #if defined(KOKKOS_COMPILER_INTEL_LLVM) && \
     KOKKOS_COMPILER_INTEL_LLVM >= 20250000
     auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
@@ -816,6 +842,7 @@ struct Random_UniqueIndex<Kokkos::Device<Kokkos::SYCL, MemorySpace>> {
       }
     }
     return i;
+#endif
   }
 };
 #endif
