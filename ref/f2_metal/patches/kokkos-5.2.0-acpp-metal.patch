diff --git a/core/src/SYCL/Kokkos_SYCL_WorkgroupReduction.hpp b/core/src/SYCL/Kokkos_SYCL_WorkgroupReduction.hpp
index 49f2dfa6e..3b1d4d645 100644
--- a/core/src/SYCL/Kokkos_SYCL_WorkgroupReduction.hpp
+++ b/core/src/SYCL/Kokkos_SYCL_WorkgroupReduction.hpp
@@ -237,6 +237,58 @@ std::enable_if_t<use_shuffle_based_algorithm<ReducerType>> workgroup_reduction(
   }
 }
 
+
+// F2 experiment: two-pass reduction for AdaptiveCpp's Metal backend.
+// The default single-pass scheme lets the last work-group read the partial
+// results of the other work-groups after a device-scope acq_rel atomic. On
+// AdaptiveCpp + Metal those plain stores are not reliably visible, so we only
+// let a work-group finish the reduction when it is the only one, and combine
+// the partial results of several work-groups in a second kernel. The kernel
+// boundary on the in-order queue makes the partial results visible.
+#if defined(__ACPP__)
+inline constexpr bool use_two_pass_reduction = true;
+#else
+inline constexpr bool use_two_pass_reduction = false;
+#endif
+
+template <typename ValueType, typename FunctorReducerWrapper>
+sycl::event two_pass_final_reduction(
+    sycl::queue& q, const FunctorReducerWrapper& functor_reducer_wrapper,
+    sycl::global_ptr<ValueType> results_ptr,
+    sycl::global_ptr<ValueType> device_accessible_result_ptr,
+    unsigned int value_count_, std::size_t n_wgroups) {
+  constexpr std::size_t wgroup_size = 256;
+  const unsigned int value_count    = std::max(value_count_, 1u);
+  return q.submit([&](sycl::handler& cgh) {
+    sycl::local_accessor<ValueType> local_mem(
+        sycl::range<1>(wgroup_size) * value_count, cgh);
+    cgh.parallel_for(
+        sycl::nd_range<1>(wgroup_size, wgroup_size),
+        [=](sycl::nd_item<1> item) {
+          const auto& fr_raw = functor_reducer_wrapper.get_functor();
+          using FR =
+              std::unwrap_reference_t<std::decay_t<decltype(fr_raw)>>;
+          const FR& fr        = fr_raw;
+          const auto& reducer = fr.get_reducer();
+          const std::size_t local_id = item.get_local_linear_id();
+          auto* mine = &local_mem[local_id * value_count];
+          if (local_id >= n_wgroups)
+            reducer.init(mine);
+          else {
+            reducer.copy(mine, &results_ptr[local_id * value_count]);
+            for (std::size_t id = local_id + wgroup_size; id < n_wgroups;
+                 id += wgroup_size)
+              reducer.join(mine, &results_ptr[id * value_count]);
+          }
+          sycl::group_barrier(item.get_group());
+          workgroup_reduction<>(item, local_mem, results_ptr,
+                                device_accessible_result_ptr, value_count,
+                                reducer, true,
+                                std::min<std::size_t>(n_wgroups, wgroup_size));
+        });
+  });
+}
+
 }  // namespace Kokkos::Impl::SYCLReduction
 
